# =============================================================================
# LLM Edge Gateway - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The gateway will fail to start if GATEWAY_API_KEY or GROQ_API_KEY are empty.
# =============================================================================
#
# ---- Manual export for client-side testing (e.g. curl) ---------------------
# The gateway itself auto-loads this file at startup, but YOUR SHELL does not.
# When you open a second terminal to test with curl, you need to export the
# values manually. Two equivalent options:
#
#   # 1) Export in the current terminal session (lost on close):
#   export GATEWAY_API_KEY=demo-key-1234567890
#   export GROQ_API_KEY=gsk_your_real_groq_key_here
#   curl -X POST http://localhost:8080/v1/chat/completions \
#     -H "Authorization: Bearer $GATEWAY_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"model":"llama-3.3-70b-versatile","messages":[{"role":"user","content":"What is Go?"}]}'
#
#   # 2) One-liner that exports everything from .env into the current shell:
#   set -a && source .env && set +a
#
# Notes:
#   - GATEWAY_API_KEY  is the Bearer token the gateway validates. Anything
#                      non-empty works for local testing (the placeholder
#                      "replace-me-with-a-long-random-string" is rejected).
#   - GROQ_API_KEY     must be a REAL key from https://console.groq.com/keys.
#                      Leave it empty to force every request to fall back to
#                      the local Ollama model (useful for offline testing).
# ----------------------------------------------------------------------------

# ---- Server ----
GATEWAY_PORT=8080
GATEWAY_READ_TIMEOUT=30s
GATEWAY_WRITE_TIMEOUT=30s

# ---- Auth ----
# Single API key. Clients send: Authorization: Bearer <this_value>
# Leave blank to make the gateway REFUSE TO START (fail-closed).
GATEWAY_API_KEY=replace-me-with-a-long-random-string

# ---- Upstream LLM (Groq) ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=8s

# ---- Local Fallback (Ollama) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT=120s

# ---- Embeddings (Ollama) ----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_URL=http://localhost:11434
EMBEDDING_DIMS=768

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- Cache ----
# Threshold for cosine similarity to count as a cache hit.
# Note: nomic-embed-text without 'search_query:' prefix produces
# similarity scores in the 0.6-0.85 range for related queries.
# 0.85 is a reasonable balance. Increase toward 0.95 for stricter matching.
CACHE_SIMILARITY_THRESHOLD=0.85
# TTL must use Go duration format: 168h = 168 hours (1 week)
CACHE_TTL=168h

# ---- Circuit Breaker ----
# Trip after this many consecutive failures
BREAKER_FAILURE_THRESHOLD=3
# Wait this long before going from open to half-open
BREAKER_OPEN_TIMEOUT=30s
# Probe count when half-open
BREAKER_HALF_OPEN_MAX_REQUESTS=1
# Request timeout: if upstream takes longer, count as failure
BREAKER_REQUEST_TIMEOUT=5s
